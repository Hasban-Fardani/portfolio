# Copy to .env for local tooling only. NEVER commit a real key.
# Production: set the secret with `bunx wrangler secret put OPENROUTER_API_KEY`
# (or in the Cloudflare dashboard). Local dev: put the same name in .dev.vars.
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key
# Optional. Defaults to a free model when unset.
OPENROUTER_MODEL=openrouter/free
# Admin login via GitHub/Google (production: set all four as Worker secrets).
EMDASH_OAUTH_GITHUB_CLIENT_ID=[REDACTED]
EMDASH_OAUTH_GITHUB_CLIENT_SECRET=[REDACTED]
EMDASH_OAUTH_GOOGLE_CLIENT_ID=[REDACTED]
EMDASH_OAUTH_GOOGLE_CLIENT_SECRET=[REDACTED]
