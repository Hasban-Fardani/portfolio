				});
			}, { rootMargin: "-38% 0px -55% 0px" });
			$$("main section[id]").forEach((s) => spy.observe(s));

			/* ---------- Mobile menu ---------- */
			const burger = $("#burger");
			const mobileMenu = $("#mobileMenu");
			function setMenu(open) {
				if (!burger || !mobileMenu) return;
				mobileMenu.hidden = !open;
				burger.setAttribute("aria-expanded", String(open));
				burger.setAttribute("aria-label", open ? "Close menu" : "Open menu");
			}
			burger?.addEventListener("click", () => setMenu(mobileMenu.hidden));
			panelLinks.forEach((l) => l.addEventListener("click", () => setMenu(false)));
			document.addEventListener("keydown", (e) => {
				if (e.key === "Escape" && mobileMenu && !mobileMenu.hidden) {
					setMenu(false);
					burger?.focus();
				}
			});
			document.addEventListener("click", (e) => {
				if (mobileMenu && !mobileMenu.hidden && nav && !nav.contains(e.target)) setMenu(false);
			});
			window.matchMedia("(min-width: 1151px)").addEventListener("change", (e) => {
				if (!e.matches) return;
				setMenu(false);
				const cur = navLinks.find((l) => l.classList.contains("is-active"));
				if (cur) movePill(cur, false);
			});

			/* ---------- Stack layers inspector ---------- */
			const parseJson = (id) => { try { return JSON.parse(document.getElementById(id)?.textContent || "null"); } catch { return null; } };
			const FOCUS = parseJson("layerData") || [];
			const layerBtns = $$("[data-layer]");
			const inspectorText = $("#inspectorText");
			const inspectorTag = $("#inspectorTag");
			layerBtns.forEach((btn) => {
				btn.addEventListener("click", () => {
					const i = Number(btn.dataset.layer);
					layerBtns.forEach((b) => {
						const on = b === btn;
						b.classList.toggle("is-selected", on);
						b.setAttribute("aria-pressed", String(on));
					});
					if (inspectorTag) inspectorTag.textContent = `FOCUS — LAYER ${String(i + 1).padStart(2, "0")}`;
					if (inspectorText) {
						if (hasGsap && !reduced) {
							gsap.fromTo(inspectorText, { opacity: 0, y: 6 }, { opacity: 1, y: 0, duration: 0.35, ease: "power2.out" });
						}
						inspectorText.textContent = FOCUS[i];
					}
				});
			});

			/* ---------- SERP switcher (textContent only) ---------- */
			const SERP = {};
			(parseJson("serpData") || []).forEach((it) => { SERP[it.key] = { query: it.query, url: it.url, title: it.title, desc: it.description, note: it.note }; });
			$$("[data-serp]").forEach((btn) => {
				btn.addEventListener("click", () => {
					const d = SERP[btn.dataset.serp];
					if (!d) return;
					$$("[data-serp]").forEach((b) => {
						const on = b === btn;
						b.classList.toggle("is-active", on);
						b.classList.toggle("btn-ink", on);
						b.classList.toggle("btn-ghost", !on);
						b.setAttribute("aria-pressed", String(on));
					});
					$("#serpQuery").textContent = d.query;
					$("#serpUrl").textContent = d.url;
					$("#serpTitle").textContent = d.title;
					$("#serpDesc").textContent = d.desc;
					$("#serpNote").textContent = d.note;
					const visit = $("#serpVisit");
					visit.setAttribute("href", d.url);
					if (hasGsap && !reduced) gsap.fromTo(".serp-result", { opacity: 0.35, y: 5 }, { opacity: 1, y: 0, duration: 0.4, ease: "power2.out" });
				});
			});

			/* ---------- Case code drawers (Flip) ---------- */
			$$("[data-inspect]").forEach((btn) => {
				btn.addEventListener("click", () => {
					const wrap = $(`[data-code="${btn.dataset.inspect}"]`);
					if (!wrap) return;
					const open = wrap.hidden;
					const card = btn.closest(".case-card");
					if (hasGsap && !reduced && card) {
						const state = Flip.getState(card);
						wrap.hidden = !open;
						btn.setAttribute("aria-expanded", String(open));
						btn.textContent = open ? "Hide Code" : "Inspect Code";
						Flip.from(state, { duration: 0.5, ease: "power3.inOut", onComplete: () => ScrollTrigger.refresh() });
					} else {
						wrap.hidden = !open;
						btn.setAttribute("aria-expanded", String(open));
						btn.textContent = open ? "Hide Code" : "Inspect Code";
					}
				});
			});

			/* ---------- Copy email ---------- */
			const copyBtn = $("#copyEmail");
			copyBtn?.addEventListener("click", async () => {
				const email = copyBtn.dataset.email || "";
				const original = copyBtn.textContent;
				try {
					await navigator.clipboard.writeText(email);
				} catch (e) {
					const ta = document.createElement("textarea");
					ta.value = email; document.body.appendChild(ta); ta.select();
					document.execCommand("copy"); ta.remove();
				}
				copyBtn.textContent = "Copied ✓";
				setTimeout(() => { copyBtn.textContent = original; }, 1800);
			});

			/* ---------- AI drawer ---------- */
			const drawer = $("#aiDrawer");
			const backdrop = $("#drawerBackdrop");
			const chatInput = $("#chatInput");
			const chatLog = $("#chatLog");
			let lastFocus = null;
			function openDrawer() {
				lastFocus = document.activeElement;
				drawer.hidden = false; backdrop.hidden = false;
				drawer.setAttribute("aria-hidden", "false");
				requestAnimationFrame(() => drawer.classList.add("open"));
				setTimeout(() => chatInput?.focus(), 80);
			}
			function closeDrawer() {
				drawer.classList.remove("open");
				drawer.setAttribute("aria-hidden", "true");
				setTimeout(() => { drawer.hidden = true; backdrop.hidden = true; }, reduced ? 0 : 380);
				if (lastFocus && lastFocus.focus) lastFocus.focus();
			}
			$$("[data-ask-open]").forEach((b) => b.addEventListener("click", openDrawer));
			$("#drawerClose")?.addEventListener("click", closeDrawer);
			backdrop?.addEventListener("click", closeDrawer);
			document.addEventListener("keydown", (e) => {
				if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
					e.preventDefault();
					if (drawer.hidden) openDrawer(); else closeDrawer();
				}
				if (e.key === "Escape" && !drawer.hidden) closeDrawer();
			});
			function addMsg(kind, text) {
				const div = document.createElement("div");
				div.className = kind === "user" ? "msg msg-user" : "msg msg-ai";
				const meta = document.createElement("div");
				meta.className = "msg-meta";
				meta.textContent = kind === "user" ? "YOU" : "HASBAN'S AI";
				const body = document.createElement("div");
				body.textContent = text;
				div.appendChild(meta); div.appendChild(body);
				chatLog.appendChild(div);
				div.scrollIntoView({ block: "nearest", behavior: reduced ? "auto" : "smooth" });
				return body;
			}
			async function ask(question) {
				const q = question.trim();
				if (!q) return;
				addMsg("user", q);
				const thinking = addMsg("ai", "Thinking…");
				const send = $("#chatSend");
				send.disabled = true;
				try {
					const res = await fetch("/api/ask", {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({ question: q }),
					});
					const data = await res.json().catch(() => ({}));
					if (res.status === 503) {
						thinking.textContent = "The AI assistant is not configured yet on this deployment. Please reach Hasban directly at hasbanfardani@gmail.com or via WhatsApp — he replies fast.";
					} else if (!res.ok) {
						thinking.textContent = "Sorry — the assistant hit a snag. Please try again, or email hasbanfardani@gmail.com directly.";
					} else {
						thinking.textContent = data.answer || "No answer came back — please rephrase your question.";
					}
				} catch (err) {
					thinking.textContent = "Network hiccup — the assistant could not be reached. Please check your connection or email hasbanfardani@gmail.com.";
				} finally {
					send.disabled = false;
					chatInput.focus();
				}
			}
			$("#chatForm")?.addEventListener("submit", (e) => {
				e.preventDefault();
				const v = chatInput.value;
				chatInput.value = "";
				ask(v);
			});
			$$("[data-chip]").forEach((chip) => chip.addEventListener("click", () => ask(chip.textContent)));

			/* ---------- Tilt + spotlight ---------- */
			if (!reduced && hasGsap && window.matchMedia("(pointer: fine)").matches) {
				$$("[data-tilt]").forEach((card) => {
					const rx = gsap.quickTo(card, "rotationX", { duration: 0.5, ease: "power3.out" });
					const ry = gsap.quickTo(card, "rotationY", { duration: 0.5, ease: "power3.out" });
					gsap.set(card, { transformPerspective: 900 });
					card.addEventListener("mousemove", (e) => {
						const r = card.getBoundingClientRect();
						const px = (e.clientX - r.left) / r.width;
						const py = (e.clientY - r.top) / r.height;
						card.style.setProperty("--mx", `${px * 100}%`);
						card.style.setProperty("--my", `${py * 100}%`);
						ry((px - 0.5) * 7); rx((0.5 - py) * 7);
					});
					card.addEventListener("mouseleave", () => { rx(0); ry(0); });
				});
			}

			/* ---------- GSAP scroll animations ---------- */
			if (hasGsap && !reduced) {
				gsap.registerPlugin(ScrollTrigger);
				/* Hero entrance (load) then scroll-out */
				gsap.fromTo(".mask-line", { yPercent: 115 }, { yPercent: 0, duration: 1, stagger: 0.12, ease: "power4.out", delay: 0.1 });
				gsap.fromTo("[data-hero-fade]", { opacity: 0, y: 22 }, { opacity: 1, y: 0, duration: 0.8, stagger: 0.09, ease: "power3.out", delay: 0.35, clearProps: "transform" });
				gsap.to("#heroCopy", {
					opacity: 0.15, y: -46, ease: "none",
					scrollTrigger: { trigger: "#section-overview", start: "top top", end: "bottom top", scrub: true },
				});
				/* Stack layers unfold on hero scroll */
				gsap.fromTo(".layer",
					{ y: 26, rotationX: -38, scale: 0.96, opacity: 0.35, transformOrigin: "50% 0%" },
					{ y: 0, rotationX: 0, scale: 1, opacity: 1, stagger: 0.14, ease: "none",
						scrollTrigger: { trigger: "#stackCard", start: "top 92%", end: "top 38%", scrub: true } });

				/* Generic reveals — varied, not identical fade-ups */
				const revealCfg = {
					head: { from: { opacity: 0, y: 34 }, to: { opacity: 1, y: 0, duration: 0.85, ease: "power3.out" } },
					card: { from: { opacity: 0, y: 44 }, to: { opacity: 1, y: 0, duration: 0.9, ease: "power3.out" } },
					scale: { from: { opacity: 0, scale: 0.965, y: 18 }, to: { opacity: 1, scale: 1, y: 0, duration: 0.9, ease: "power2.out" } },
					tilt: { from: { opacity: 0, y: 40, rotationX: -7 }, to: { opacity: 1, y: 0, rotationX: 0, duration: 0.95, ease: "power3.out" } },
				};
				Object.entries(revealCfg).forEach(([kind, cfg]) => {
					const els = $$(`[data-reveal="${kind}"]`);
					if (!els.length) return;
					gsap.set(els, cfg.from);
					ScrollTrigger.batch(els, {
						start: "top 89%",
						onEnter: (batch) => gsap.to(batch, { ...cfg.to, stagger: 0.1, overwrite: true, clearProps: "transform" }),
					});
				});

				/* Manifesto word scrub */
				const man = $("#manifestoText");
				if (man) {
					const words = man.textContent.trim().split(/\s+/);
					man.textContent = "";
					words.forEach((w) => {
						const s = document.createElement("span");
						s.className = "w"; s.textContent = w;
						man.appendChild(s); man.appendChild(document.createTextNode(" "));
					});
					gsap.to("#manifestoText .w", {
						opacity: 1, stagger: 0.06, ease: "none",
						scrollTrigger: { trigger: man, start: "top 82%", end: "bottom 42%", scrub: true },
					});
				}

				/* Metrics count-up (1000 only; #1 / 0 / 1st stay static) */
				$$("[data-count]").forEach((el) => {
					const target = Number(el.dataset.count);
					const obj = { v: 0 };
					ScrollTrigger.create({
						trigger: el, start: "top 90%", once: true,
						onEnter: () => gsap.to(obj, {
							v: target, duration: 1.4, ease: "power2.out",
							onUpdate: () => { el.textContent = Math.round(obj.v).toLocaleString("en-US"); },
						}),
					});
				});

				/* Deck sync: monitor follows active case */
				const CASES = (parseJson('deckData') || []).map(function(c, idx){ return Object.assign({}, c, { bars: [100,94,88,76].map(function(v,j){ return String(Math.max(55, v - idx*4 - j*2)) + '%'; }) }); });
				const monEls = {
					counter: $("#monCounter"), big: $("#monBig"), metric: $("#monMetric"),
					label: $("#monLabel"), title: $("#monTitle"), pipeline: $("#monPipeline"),
					bars: $$("#monBars span"),
				};
				function setCase(i) {
					const c = CASES[i];
					if (!c) return;
					$$(".case-card").forEach((el) => el.classList.toggle("is-active", Number(el.dataset.case) === i));
					monEls.counter.textContent = c.counter;
					monEls.big.textContent = c.big;
					monEls.metric.textContent = c.metric;
					monEls.label.textContent = c.label;
					monEls.title.textContent = c.title;
					monEls.pipeline.textContent = "";
					c.nodes.forEach((n, idx) => {
						const li = document.createElement("li");
						li.textContent = `${String(idx + 1).padStart(2, "0")} — ${n}`;
						monEls.pipeline.appendChild(li);
					});
					monEls.bars.forEach((b, idx) => b.style.setProperty("--w", c.bars[idx] || "60%"));
					gsap.fromTo("#monitor", { opacity: 0.55 }, { opacity: 1, duration: 0.45, ease: "power2.out" });
				}
				$$(".case-card").forEach((card) => {
					const i = Number(card.dataset.case);
					ScrollTrigger.create({
						trigger: card, start: "top 58%", end: "bottom 58%",
						onEnter: () => setCase(i), onEnterBack: () => setCase(i),
					});
				});

				/* Pinned horizontal filmstrip >=1024px (centered pin) */
				const mm = gsap.matchMedia();
				mm.add("(min-width: 1024px)", () => {
					const track = $("#filmTrack");
					const viewport = $("#filmViewport");
					const getX = () => Math.max(0, track.scrollWidth - viewport.clientWidth);
					const tween = gsap.to(track, {
						x: () => -getX(), ease: "none",
						scrollTrigger: {
							trigger: "#filmSection", start: "center center", end: () => `+=${getX()}`,
							pin: true, scrub: 1, invalidateOnRefresh: true, anticipatePin: 1,
							id: "filmPin",
						},
					});
					$("#filmPrev")?.addEventListener("click", () => {
						window.scrollTo({ top: tween.scrollTrigger.start, behavior: "smooth" });
					});
					$("#filmNext")?.addEventListener("click", () => {
						window.scrollTo({ top: tween.scrollTrigger.end, behavior: "smooth" });
					});
					return () => { gsap.set(track, { x: 0 }); };
				});
				/* Mobile: Prev/Next fall back to native horizontal-less stack scroll */
				if (window.innerWidth < 1024) {
					$("#filmPrev")?.addEventListener("click", () => $("#filmSection")?.scrollIntoView({ behavior: "smooth" }));
					$("#filmNext")?.addEventListener("click", () => $("#section-capabilities")?.scrollIntoView({ behavior: "smooth" }));
				}

				/* Laser line scrub */
				gsap.to("#laser", {
					scaleY: 1, ease: "none",
					scrollTrigger: { trigger: "#timeline", start: "top 78%", end: "bottom 55%", scrub: true },
				});

				window.addEventListener("load", () => ScrollTrigger.refresh());
				document.addEventListener("astro:page-hide", () => {
					ScrollTrigger.getAll().forEach((t) => t.kill());
				});
			} else {
				/* Reduced motion / no GSAP: everything visible, film stays vertical */
				$$(".mask-line").forEach((el) => { el.style.transform = "none"; });
				const man = $("#manifestoText");
				if (man) man.style.opacity = "1";
			}
		</script>
	</body>
</html>
