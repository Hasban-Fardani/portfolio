---
import { Font } from "astro:assets";
import { getEmDashCollection, getEmDashEntry, getMenuWithCacheHint } from "emdash";
import { Image } from "emdash/ui";
import "../styles/tokens.css";
import "../styles/theme.css";

export const prerender = false;

const bySort = (a: any, b: any) => (a.data.sort_order ?? 999) - (b.data.sort_order ?? 999);

const [homeRes, projectsRes, casesRes, pillarsRes, expRes, menuRes] = await Promise.all([
	getEmDashEntry("homepage", "home"),
	getEmDashCollection("projects", { limit: 50 }),
	getEmDashCollection("cases", { limit: 50 }),
	getEmDashCollection("pillars", { limit: 50 }),
	getEmDashCollection("experiences", { limit: 50 }),
	getMenuWithCacheHint("primary"),
]);
for (const r of [homeRes, projectsRes, casesRes, pillarsRes, expRes, menuRes]) {
	if (Astro.cache?.enabled && r?.cacheHint) Astro.cache.set(r.cacheHint);
}

const home: any = homeRes.entry?.data ?? {};
const projects = [...(projectsRes.entries ?? [])].sort(bySort);
const cases = [...(casesRes.entries ?? [])].sort(bySort);
const pillars = [...(pillarsRes.entries ?? [])].sort(bySort);
const experiences = [...(expRes.entries ?? [])].sort(bySort);
const menuItems: any[] = menuRes.data?.items ?? [];
const navList =
	menuItems.length > 0
		? menuItems.map((m: any) => ({ label: m.label, url: m.url }))
		: [
				{ label: "Overview", url: "#section-overview" },
				{ label: "Systems", url: "#section-systems" },
				{ label: "Clients", url: "#section-clients" },
				{ label: "Stack", url: "#section-capabilities" },
				{ label: "Trajectory", url: "#section-experience" },
				{ label: "Contact", url: "#section-contact" },
			];

const metrics: any[] = home.metrics ?? [];
const layers: any[] = home.layers ?? [];
const serpItems: any[] = home.serp_items ?? [];
const firstCase = cases[0];
const firstSerp = serpItems[0];
const splitPipeline = (p?: string) => (p ?? "").split(/→|\//).map((s) => s.trim()).filter(Boolean);
const firstNodes = splitPipeline(firstCase?.data.pipeline);
const pad = (n: number) => String(n).padStart(2, "0");
const deckData = cases.map((c: any, i: number) => ({
	counter: `${pad(i + 1)} / ${pad(cases.length)}`, big: pad(i + 1),
	metric: c.data.metric ?? "", label: c.data.metric_label ?? "", title: c.data.title ?? "",
	nodes: splitPipeline(c.data.pipeline),
}));
const layerNotes = layers.map((l: any) => l.note ?? l.description ?? "");
const jsonLd = {
	"@context": "https://schema.org", "@type": "Person", name: "Hasban Fardani",
	jobTitle: "End-to-End Fullstack Engineer", url: home.contact_website_url ?? "https://hasban.my.id",
	email: home.contact_email ?? "", address: { "@type": "PostalAddress", addressLocality: "Cimahi / Bandung", addressCountry: "ID" },
	knowsAbout: ["Laravel", "Payment APIs", "ERP Systems", "Technical SEO", "React Native", "PostgreSQL", "Pest PHP", "Nginx"],
};
const serpJson = JSON.stringify(serpItems).replace(/</g, "\\u003c");
const deckJson = JSON.stringify(deckData).replace(/</g, "\\u003c");
const layerJson = JSON.stringify(layerNotes).replace(/</g, "\\u003c");
---


<!doctype html>
<html lang="en" data-theme="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Hasban Fardani · End-to-End Fullstack Engineer (Web, ERP, Mobile, Cloud & #1 SEO)</title>
		<meta
			name="description"
			content="Hasban Fardani — End-to-End Fullstack Engineer in Cimahi/Bandung. Laravel payment backends, Pest-tested ERP, mobile & AI apps, and client websites ranked #1 on Google for kalibrasi tutsit."
		/>
		<meta property="og:type" content="website" />
		<meta property="og:title" content="Hasban Fardani · End-to-End Fullstack Engineer" />
		<meta
			property="og:description"
			content="Complete digital products from database to #1 SEO: payment gateways, ERP, mobile/AI, and #1 Google client sites."
		/>
		<meta property="og:url" content="https://hasban.my.id/" />
		<meta name="twitter:card" content="summary" />
		<Font cssVariable="--font-heading" preload />
		<Font cssVariable="--font-mono" preload />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<script is:inline>
			(function () {
				try {
					var t = localStorage.getItem("hasban-theme");
					if (t !== "dark" && t !== "light") {
						t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
					}
					document.documentElement.setAttribute("data-theme", t);
				} catch (e) {
					document.documentElement.setAttribute("data-theme", "light");
				}
			})();
		</script>
	</head>
	<body>
		<div class="theme-wipe" id="themeWipe" aria-hidden="true"></div>

		<header class="pill-nav" id="pillNav">
			<a class="brand" href="#section-overview" aria-label="Hasban Fardani — home">
				<span class="brand-dot" aria-hidden="true"></span>
				<span class="brand-name">Hasban Fardani</span>
				<span class="brand-role">· Fullstack Engineer</span>
				<span class="brand-loc t-mono" id="brandLoc">Cimahi / Bandung</span>
			</a>
			<nav class="nav-links" id="navLinks" aria-label="Homepage sections">
				<span class="nav-pill" id="navPill" aria-hidden="true"></span>
				{navList.map((item: any, i: number) => (
					<a class:list={["nav-link", i === 0 && "is-active"]} data-nav href={item.url}><span class="nav-label">{item.label}</span></a>
				))}
			</nav>
			<div class="nav-actions">
				<button class="ask-btn" type="button" data-ask-open aria-haspopup="dialog">
					Ask AI <span class="kbd" aria-hidden="true">⌘K</span>
				</button>
				<button class="theme-toggle" id="themeToggle" type="button" aria-label="Toggle color theme">
					<svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
					<svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
					<span id="themeLabel">Dark</span>
				</button>
				<button class="burger" id="burger" type="button" aria-expanded="false" aria-controls="mobileMenu" aria-label="Open menu">
					<span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
				</button>
			</div>
			<nav class="mobile-menu" id="mobileMenu" aria-label="Homepage sections" hidden>
				{navList.map((item: any, i: number) => (
					<a class:list={["m-link", i === 0 && "is-active"]} data-nav-panel href={item.url}>{item.label}</a>
				))}
			</nav>
		</header>

		<main>
			<!-- 1) HERO -->
			<section class="hero container" id="section-overview" aria-label="Overview">
				<div class="hero-copy" id="heroCopy">
					<p class="eyebrow" data-hero-fade>
						<span class="dot-live" aria-hidden="true"></span>
						{home.hero_eyebrow}
					</p>
					<p class="t-mono hero-mono" data-hero-fade>{home.hero_meta}</p>
					<h1 class="t-display hero-title">
						<span class="mask"><span class="mask-line">{home.hero_line1}</span></span>
						<span class="mask"><span class="mask-line">{home.hero_line2}</span></span>
						<span class="mask"><span class="mask-line"><em>{home.hero_line_accent}</em></span></span>
					</h1>
					<p class="t-body hero-pitch" data-hero-fade>{home.hero_pitch}</p>
					<div class="hero-ctas" data-hero-fade>
						<a class="btn btn-ink" href="#section-systems">Production Systems</a>
						<a class="btn btn-ghost" href="#section-clients">Live #1 Google Client Sites</a>
						<button class="btn btn-accent" type="button" data-ask-open>Ask AI <span class="kbd" aria-hidden="true">⌘K</span></button>
					</div>
					<dl class="metrics" data-hero-fade>
						{metrics.map((m: any) => (
							<div class="metric"><dt class="t-mono">{m.label}</dt><dd class="metric-value">{m.value}</dd></div>
						))}
					</dl>
				</div>

				<div class="stack-card card" id="stackCard" data-hero-fade aria-label="Interactive technology stack">
					<p class="t-mono stack-head">THE STACK — TAP A LAYER</p>
					<div class="layers" id="layers">
						{
							layers.map((l: any, i: number) => (
								<button
									class:list={["layer", i === 0 && "is-selected"]}
									type="button"
									data-layer={i}
									aria-pressed={i === 0 ? "true" : "false"}
								>
									<span class="t-mono layer-id">{l.kicker}</span>
									<span class="layer-name">{l.title}</span>
									<span class="layer-tools">{l.badge}</span>
									<span class="layer-tools">{l.description}</span>
								</button>
							))
						}
					</div>
					<div class="inspector" role="status" aria-live="polite">
						<p class="t-mono inspector-tag" id="inspectorTag">FOCUS — {layers[0]?.kicker}</p>
						<p class="inspector-text" id="inspectorText">{layers[0]?.note}</p>
					</div>
				</div>
			</section>

			<!-- 2) SYSTEMS -->
			<section class="section container" id="section-systems" aria-label="Enterprise and backend systems">
				<div class="manifesto" data-reveal="manifesto">
					<p class="t-mono kicker">{home.manifesto_kicker}</p>
					<p class="manifesto-text" id="manifestoText">{home.manifesto}</p>
				</div>

				<header class="sec-head" data-reveal="head">
					<p class="t-mono kicker">{home.systems_kicker}</p>
					<h2 class="t-h2">{home.systems_title}</h2>
					{home.systems_intro && <p class="t-body">{home.systems_intro}</p>}
				</header>

				<div class="deck">
					<aside class="monitor card" id="monitor" aria-label="Active case monitor" data-metric={firstCase?.data.metric} data-metric-label={firstCase?.data.metric_label} data-title={firstCase?.data.title}>
						<div class="monitor-top">
							<span class="t-mono" id="monCounter">{cases.length ? `01 / ${pad(cases.length)}` : ""}</span>
							<span class="mon-big" id="monBig">01</span>
						</div>
						<p class="mon-metric" id="monMetric">{firstCase?.data.metric}</p>
						<p class="t-mono mon-label" id="monLabel">{firstCase?.data.metric_label}</p>
						<p class="mon-title" id="monTitle">{firstCase?.data.title}</p>
						<ol class="pipeline" id="monPipeline">
							{firstNodes.map((n: string) => <li>{n}</li>)}
						</ol>
						<div class="bars" id="monBars" aria-hidden="true">
							<span style="--w:100%"></span><span style="--w:96%"></span><span style="--w:92%"></span><span style="--w:70%"></span>
						</div>
					</aside>

					<div class="case-list">
						{
							cases.map((entry: any, i: number) => (
								<article class:list={["card", "case-card", i === 0 && "is-active"]} data-case={i} data-reveal="card" data-metric={entry.data.metric} data-metric-label={entry.data.metric_label} data-title={entry.data.title} data-pipeline={entry.data.pipeline}>
									<p class="t-mono kicker">{entry.data.kicker}</p>
									<h3 class="t-h2 case-title">{entry.data.title}</h3>
									<p class="t-body">{entry.data.summary}</p>
									<button class="btn btn-ghost inspect-btn" type="button" data-inspect={i} aria-expanded="false">
										Inspect Code
									</button>
									<div class="code-wrap" data-code={i} hidden>
										<pre tabindex="0"><code>{entry.data.code}</code></pre>
									</div>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<!-- 3) CLIENTS -->
			<section class="section container" id="section-clients" aria-label="Live client platforms and SEO">
				<header class="sec-head card head-card" data-reveal="head">
					<p class="t-mono kicker">{home.clients_kicker}</p>
					<h2 class="t-h2">{home.clients_title}</h2>
					<div class="serp-switch" role="group" aria-label="Choose a search result example">
						{serpItems.map((s: any, i: number) => (
							<button class:list={["btn", "serp-btn", i === 0 ? "btn-ink is-active" : "btn-ghost"]} type="button" data-serp={s.key} aria-pressed={i === 0 ? "true" : "false"}>{s.button_label}</button>
						))}
					</div>
				</header>

				<div class="serp card" data-reveal="scale" aria-label="Search result preview">
					<p class="t-mono serp-query">Google search: <span id="serpQuery">{firstSerp?.query}</span></p>
					<div class="serp-result">
						<span class="badge badge-emerald">#1 Organic Result</span>
						<p class="t-mono serp-url" id="serpUrl">{firstSerp?.url}</p>
						<p class="serp-title" id="serpTitle">{firstSerp?.title}</p>
						<p class="t-body serp-desc" id="serpDesc">{firstSerp?.description}</p>
						<p class="t-mono serp-note" id="serpNote">{firstSerp?.note}</p>
						<a class="btn btn-accent serp-visit" id="serpVisit" href={firstSerp?.url} target="_blank" rel="noreferrer">Visit live site ↗</a>
					</div>
				</div>
				<script is:inline type="application/json" id="serpData" set:html={serpJson} />
				<script is:inline type="application/json" id="deckData" set:html={deckJson} />
				<script is:inline type="application/json" id="layerData" set:html={layerJson} />

				<div class="film" id="filmSection">
					<div class="film-head" data-reveal="head">
						<p class="t-mono kicker">Selected live builds — scroll</p>
						<div class="film-nav">
							<button class="btn btn-ghost" type="button" id="filmPrev">← Prev</button>
							<button class="btn btn-ghost" type="button" id="filmNext">Next →</button>
						</div>
					</div>
					<div class="film-viewport" id="filmViewport">
						<div class="film-track" id="filmTrack">
							{
								projects.map((entry: any, i: number) => (
									<article class="card film-card" data-reveal="card">
										<div class="film-media">
											{entry.data.featured_image && <Image image={entry.data.featured_image} loading="lazy" />}
											{entry.data.highlight && <span class="badge badge-emerald film-badge">{entry.data.highlight}</span>}
											<div class="film-overlay">
												<span class="t-mono">{pad(i + 1)} — {entry.data.client}</span>
												<span class="film-overlay-title">{entry.data.title}</span>
											</div>
										</div>
										<p class="t-body film-summary">{entry.data.summary}</p>
										<footer class="film-foot">
											<span class="badge badge-accent">{entry.data.status_label}</span>
											{entry.data.url ? (
												<a href={entry.data.url} target="_blank" rel="noreferrer">Visit live site ↗</a>
											) : (
												<a href={`/work/${entry.id}`}>View project</a>
											)}
										</footer>
									</article>
								))
							}
						</div>
					</div>
				</div>
			</section>

			<!-- 4) CAPABILITIES -->
			<section class="section container" id="section-capabilities" aria-label="Capabilities">
				<header class="sec-head" data-reveal="head">
					<p class="t-mono kicker">{home.capabilities_kicker}</p>
					<h2 class="t-h2">{home.capabilities_title}</h2>
				</header>
				<div class="pillars">
					{
						pillars.map((entry: any) => (
							<article class="card pillar" data-tilt data-reveal="tilt">
								<p class="t-mono kicker">{entry.data.kicker}</p>
								<h3 class="t-h2 pillar-title">{entry.data.title}</h3>
								<p class="t-body">{entry.data.body}</p>
								{entry.data.badge && <span class="badge badge-emerald">{entry.data.badge}</span>}
							</article>
						))
					}
				</div>
			</section>

			<!-- 5) EXPERIENCE -->
			<section class="section container" id="section-experience" aria-label="Experience">
				<header class="sec-head" data-reveal="head">
					<p class="t-mono kicker">{home.experience_kicker}</p>
					<h2 class="t-h2">{home.experience_title}</h2>
				</header>
				<div class="timeline" id="timeline">
					<span class="laser" id="laser" aria-hidden="true"></span>
					{
						experiences.map((entry: any) => (
							<article class="card tl-item" data-reveal="card">
								<p class="t-mono kicker">{entry.data.meta}</p>
								<h3 class="t-h2 tl-org">{entry.data.title}</h3>
								<div class:list={["tl-points", (entry.data.points?.length ?? 0) >= 3 ? "cols-3" : (entry.data.points?.length ?? 0) === 2 ? "cols-2" : "cols-1"]}>
									{(entry.data.points ?? []).map((pt: any) => (
										<div class="tl-point"><p class="tl-point-title">{pt.title}</p><p class="t-body">{pt.body}</p></div>
									))}
								</div>
							</article>
						))
					}
				</div>
			</section>

			<!-- 6) CONTACT -->
			<section class="section container" id="section-contact" aria-label="Contact">
				<div class="card contact-card" data-reveal="scale">
					<p class="t-mono kicker">{home.contact_kicker}</p>
					<h2 class="t-display contact-title">{home.contact_title}</h2>
					<p class="t-body">{home.contact_body}</p>
					<div class="contact-actions">
						<button class="btn btn-ink" type="button" id="copyEmail" data-email={home.contact_email}>Copy email — {home.contact_email}</button>
						<a class="btn btn-ghost" href={home.contact_whatsapp_url} target="_blank" rel="noreferrer">WhatsApp ↗</a>
						<a class="btn btn-ghost" href={home.contact_website_url} target="_blank" rel="noreferrer">hasban.my.id ↗</a>
						<button class="btn btn-accent" type="button" data-ask-open>Launch AI CV Assistant <span class="kbd" aria-hidden="true">⌘K</span></button>
					</div>
					<p class="t-mono contact-foot">{home.contact_email} · Cimahi / Bandung</p>
				</div>
			</section>
		</main>

		<footer class="site-foot container">
			<p class="t-mono">© Hasban Fardani — End-to-End Fullstack Engineer · <a href="/work">Work</a> · <a href="/about">About</a> · <a href="/contact">Contact</a> · <a href="/_emdash/admin">Admin</a></p>
		</footer>

		<!-- 7) AI DRAWER -->
		<div class="drawer-backdrop" id="drawerBackdrop" hidden></div>
		<aside class="drawer" id="aiDrawer" role="dialog" aria-modal="true" aria-labelledby="drawerTitle" aria-hidden="true" hidden>
			<header class="drawer-head">
				<div>
					<p class="t-mono kicker">AI CV Assistant</p>
					<h2 class="t-h2" id="drawerTitle">Ask Hasban&rsquo;s AI</h2>
				</div>
				<button class="btn btn-ghost drawer-close" type="button" id="drawerClose" aria-label="Close AI assistant">✕ Close</button>
			</header>
			<div class="drawer-body">
				<div class="card welcome-card">
					<p class="t-body">Halo! Ask me anything about Hasban&rsquo;s work — payment security, ERP, the #1 Google client sites, or availability. Answers come from his real CV, server-side.</p>
				</div>
				<div class="chips" role="group" aria-label="Suggested questions">
					<button class="chip" type="button" data-chip>How did kalibrasi tutsit &amp; Barkas reach #1 / Page-1 on Google?</button>
					<button class="chip" type="button" data-chip>How do you stop payment spoofing &amp; double clicks?</button>
					<button class="chip" type="button" data-chip>What proves Hasban is end-to-end fullstack?</button>
				</div>
				<div class="chat-log" id="chatLog" aria-live="polite"></div>
				<!-- chat log anchor -->
				<form class="chat-form" id="chatForm">
					<label class="sr-only" for="chatInput">Your question about Hasban</label>
					<input id="chatInput" name="question" type="text" maxlength="1000" placeholder="Ask about Hasban&rsquo;s experience…" autocomplete="off" />
					<button class="btn btn-accent" type="submit" id="chatSend">Send</button>
				</form>
			</div>
		</aside>

		<style>
			* { box-sizing: border-box; }
			html { scroll-behavior: smooth; }
			body {
				margin: 0; background: var(--bg); color: var(--body);
				font-family: var(--font-heading), system-ui, sans-serif;
				font-size: var(--fs-body); line-height: 1.72;
				-webkit-font-smoothing: antialiased; overflow-x: hidden;
			}
			.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
			.container { max-width: var(--container); margin-inline: auto; padding-inline: var(--side-pad); }
			.section { padding-block: var(--section-pad); border-top: 1px solid var(--border); }
			.card {
				background: var(--card); border: 1px solid var(--border);
				border-radius: var(--card-radius); padding: var(--card-pad);
			}
			.kicker { color: var(--muted); text-transform: uppercase; margin: 0 0 0.85rem; }
			.kicker-num, .nl-num { color: var(--accent); }
			.kicker-sub { text-transform: none; }
			.badge {
				display: inline-block; padding: 0.3rem 0.7rem; border-radius: 999px;
				font-family: var(--font-mono), monospace; font-size: var(--fs-mono);
				border: 1px solid var(--border); color: var(--ink); background: var(--surface);
			}
			.badge-emerald { color: var(--emerald); border-color: var(--emerald); background: transparent; }
			.badge-accent { color: var(--accent); border-color: var(--accent); background: transparent; }
			.btn {
				display: inline-flex; align-items: center; gap: 0.5rem; cursor: pointer;
				padding: 0.72rem 1.25rem; border-radius: 999px; border: 1px solid var(--border);
				font: inherit; font-size: 0.95rem; font-weight: 600; text-decoration: none;
				background: var(--card); color: var(--ink); transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease;
			}
			.btn:hover { transform: translateY(-1px); }
			.btn-ink { background: var(--ink); color: var(--bg); border-color: var(--ink); }
			.btn-accent { background: var(--accent); color: #fff; border-color: var(--accent); }
			.btn-ghost { background: transparent; }
			.kbd {
