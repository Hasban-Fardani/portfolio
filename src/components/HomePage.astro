---
import { Font } from "astro:assets";
import {
	getEmDashCollection,
	getEmDashEntry,
	getMenuWithCacheHint,
} from "emdash";
import { Image } from "emdash/ui";
import { SEO } from "astro-seo";
import "../styles/tokens.css";
import "../styles/theme.css";

const { locale = "en" } = Astro.props as { locale?: "en" | "id" };
const isId = locale === "id";
const siteUrl = "https://hasban.my.id";
const pagePath = isId ? "/id/" : "/";
const canonical = new URL(pagePath, siteUrl).href;
const STR = {
	en: {
		askAi: "Ask AI", systems: "View systems work", clients: "Client sites at #1",
		stackHead: "Tap a layer to inspect the stack", inspect: "Inspect Code",
		visit: "Visit live site", viewProject: "View project", builds: "Selected live builds",
		prev: "Prev", next: "Next", google: "Google search:", organic: "#1 Organic Result",
		recognition: "Recognition", recogLead: "Certificates and achievements, verified.",
		certificates: "Certificates", achievements: "Achievements",
		copyEmail: "Copy email:", askTitle: "Ask Hasban's AI",
		welcome: "Halo! Ask me anything about Hasban's work: payment security, ERP, the #1 Google client sites, or availability. Answers come from his real CV, server-side.",
		chip1: "How did kalibrasi tutsit & Barkas reach #1 / Page-1 on Google?",
		chip2: "How do you stop payment spoofing & double clicks?",
		chip3: "What proves Hasban is end-to-end fullstack?",
		placeholder: "Ask about Hasban's experience…", send: "Send", close: "Close",
		proofCta: "See how it ranked #1",
		footRole: "End-to-End Fullstack Engineer", work: "Work", about: "About", contact: "Contact",
		seoTitle: "Hasban Fardani · End-to-End Fullstack Engineer (Web, ERP, Mobile, Cloud & #1 SEO)",
		seoDesc: "Hasban Fardani, End-to-End Fullstack Engineer in Cimahi/Bandung. Laravel payment backends, Pest-tested ERP, mobile & AI apps, and client websites ranked #1 on Google for kalibrasi tutsit.",
	},
	id: {
		askAi: "Tanya AI", systems: "Lihat hasil sistem", clients: "Situs klien di #1",
		stackHead: "Ketuk layer untuk melihat stack", inspect: "Lihat Kode",
		visit: "Kunjungi situs", viewProject: "Lihat proyek", builds: "Proyek live pilihan",
		prev: "Sebelumnya", next: "Berikutnya", google: "Penelusuran Google:", organic: "Hasil Organik #1",
		recognition: "Pengakuan", recogLead: "Sertifikat dan pencapaian, terverifikasi.",
		certificates: "Sertifikat", achievements: "Pencapaian",
		copyEmail: "Salin email:", askTitle: "Tanya AI Hasban",
		welcome: "Halo! Tanya apa saja tentang pekerjaan Hasban: keamanan pembayaran, ERP, situs klien #1 di Google, atau ketersediaannya. Jawaban berasal dari CV aslinya, diproses di server.",
		chip1: "Bagaimana kalibrasi tutsit & Barkas bisa #1 / Halaman-1 Google?",
		chip2: "Bagaimana cara menghentikan payment spoofing & double clicks?",
		chip3: "Apa bukti Hasban fullstack end-to-end?",
		placeholder: "Tanya pengalaman Hasban…", send: "Kirim", close: "Tutup",
		proofCta: "Lihat caranya ranking #1",
		footRole: "End-to-End Fullstack Engineer", work: "Karya", about: "Tentang", contact: "Kontak",
		seoTitle: "Hasban Fardani · Fullstack Engineer End-to-End (Web, ERP, Mobile, Cloud & SEO #1)",
		seoDesc: "Hasban Fardani, Fullstack Engineer End-to-End di Cimahi/Bandung. Backend pembayaran Laravel, ERP teruji Pest, aplikasi mobile & AI, dan situs klien peringkat #1 Google untuk kalibrasi tutsit.",
	},
} as const;
const s = STR[locale];

const bySort = (a: any, b: any) =>
	(a.data.sort_order ?? 999) - (b.data.sort_order ?? 999);

const [homeRes, projectsRes, casesRes, pillarsRes, expRes, menuRes] =
	await Promise.all([
		getEmDashEntry("homepage", isId ? "home-id" : "home").then((r: any) =>
			r?.entry ? r : getEmDashEntry("homepage", "home"),
		),
		getEmDashCollection("projects", { limit: 50 }),
		getEmDashCollection("cases", { limit: 50 }),
		getEmDashCollection("pillars", { limit: 50 }),
		getEmDashCollection("experiences", { limit: 50 }),
		getMenuWithCacheHint("primary"),
	]);
for (const r of [homeRes, projectsRes, casesRes, pillarsRes, expRes, menuRes]) {
	if (Astro.cache?.enabled && r?.cacheHint) Astro.cache.set(r.cacheHint);
}

const home: any = homeRes.entry?.data ?? {};
/* Locale content: entries whose id ends in "-id" are the Indonesian
   versions; fall back to English when a translation is missing. */
const pickLocale = (entries: any[], wantId: boolean) => {
	const byBase = new Map<string, any>();
	for (const e of entries ?? []) {
		const id = String(e?.id ?? "");
		const base = id.replace(/-id$/, "");
		const cur = byBase.get(base);
		const eIsId = id.endsWith("-id");
		if (!cur || (wantId && eIsId) || (!wantId && !eIsId)) byBase.set(base, e);
	}
	return [...byBase.values()];
};
const projects = pickLocale(projectsRes.entries, isId).sort(bySort);
const cases = pickLocale(casesRes.entries, isId).sort(bySort);
const pillars = pickLocale(pillarsRes.entries, isId).sort(bySort);
const experiences = pickLocale(expRes.entries, isId).sort(bySort);
const menuItems: any[] = menuRes.data?.items ?? [];
const NAV_ID: Record<string, string> = {
	"#section-overview": "Ringkasan",
	"#section-systems": "Sistem",
	"#section-clients": "Klien",
	"#section-capabilities": "Stack",
	"#section-experience": "Karier",
	"#section-contact": "Kontak",
};
const navList =
	menuItems.length > 0
		? menuItems.map((m: any) => ({ label: isId ? (NAV_ID[m.url] ?? m.label) : m.label, url: m.url }))
		: [
				{ label: isId ? "Ringkasan" : "Overview", url: "#section-overview" },
				{ label: isId ? "Sistem" : "Systems", url: "#section-systems" },
				{ label: isId ? "Klien" : "Clients", url: "#section-clients" },
				{ label: "Stack", url: "#section-capabilities" },
				{ label: isId ? "Karier" : "Trajectory", url: "#section-experience" },
				{ label: isId ? "Kontak" : "Contact", url: "#section-contact" },
			];
const proofProject = projects.find((p: any) => p?.data?.featured_image) ?? projects[0];
const caseWord = isId ? "Kasus" : "Case";
const ofWord = isId ? "dari" : "of";

/* Certificates & achievements (added in a later seed revision). Tolerate
   collections that do not exist yet on older deployments: never break the page. */
let certEntries: any[] = [];
let achEntries: any[] = [];
try {
	certEntries = (await getEmDashCollection("certificates", { limit: 30 }))?.entries ?? [];
} catch { certEntries = []; }
try {
	achEntries = (await getEmDashCollection("achievements", { limit: 30 }))?.entries ?? [];
} catch { achEntries = []; }
certEntries = pickLocale(certEntries, isId).sort(bySort);
achEntries = pickLocale(achEntries, isId).sort(bySort);

/* Render-time copy guard (works on any database, including content written
   before the current copy standards): no em-dashes, and no legacy overclaims. */
const noEmDash = (v: any): any => {
	if (typeof v === "string") return v.replace(/(\d{4}) — ([A-Z0-9])/g, "$1 – $2").replace(/ — /g, ", ");
	if (Array.isArray(v)) { v.forEach((x, i) => { v[i] = noEmDash(x); }); return v; }
	if (v && typeof v === "object") { for (const k of Object.keys(v)) v[k] = noEmDash(v[k]); return v; }
	return v;
};
[home, projects, cases, pillars, experiences, certEntries, achEntries].forEach((e: any) => noEmDash(e?.data ?? e));
if (home.manifesto) home.manifesto = String(home.manifesto).replace(/, configuring Nginx on lean 1 GB RAM servers,/, "");
const systemsTitle = /PT\s/.test(home.systems_title ?? "") ? "Production engineering, delivered on-site" : home.systems_title;

const metrics: any[] = home.metrics ?? [];
const layers: any[] = home.layers ?? [];
const serpItems: any[] = home.serp_items ?? [];
const firstCase = cases[0];
const firstSerp = serpItems[0];
const splitPipeline = (p?: string) =>
	(p ?? "")
		.split(/→|\//)
		.map((s) => s.trim())
		.filter(Boolean);
const firstNodes = splitPipeline(firstCase?.data.pipeline);
/* Presentation rule (Taste v2: no index numbering): strip leading section/
   case numbers from DB labels at render. Content stays fully editable. */
const cleanKicker = (s?: string) =>
	String(s ?? "")
		.replace(/^\s*(case|p|layer|step)\s*0?\d+\s*[—–\-/):.]\s*/i, "")
		.replace(/^\s*0?\d+\s*[/.)\-–—]\s*/, "")
		.replace(/^(layer)\s*0?\d+$/i, "$1")
		.trim();
const deckData = cases.map((c: any, i: number) => ({
	counter: `${caseWord} ${i + 1} ${ofWord} ${cases.length}`,
	metric: c.data.metric ?? "",
	label: c.data.metric_label ?? "",
	title: c.data.title ?? "",
	nodes: splitPipeline(c.data.pipeline),
}));
const layerNotes = layers.map((l: any) => l.note ?? l.description ?? "");
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: "Hasban Fardani",
	jobTitle: "End-to-End Fullstack Engineer",
	url: home.contact_website_url ?? "https://hasban.my.id",
	email: home.contact_email ?? "",
	address: {
		"@type": "PostalAddress",
		addressLocality: "Cimahi / Bandung",
		addressCountry: "ID",
	},
	knowsAbout: [
		"Laravel",
		"Payment APIs",
		"ERP Systems",
		"Technical SEO",
		"React Native",
		"PostgreSQL",
		"Pest PHP",
		"Nginx",
	],
};
const serpJson = JSON.stringify(serpItems).replace(/</g, "\\u003c");
const deckJson = JSON.stringify(deckData).replace(/</g, "\\u003c");
const layerJson = JSON.stringify(layerNotes).replace(/</g, "\\u003c");
---


<!doctype html>
<html lang={isId ? "id" : "en"} data-locale={locale} data-theme="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<SEO
			title={s.seoTitle}
			description={s.seoDesc}
			canonical={canonical}
			openGraph={{
				basic: { title: s.seoTitle, type: "website", image: `${siteUrl}/og.png`, url: canonical },
				optional: { description: s.seoDesc, siteName: "Hasban Fardani", locale: isId ? "id_ID" : "en_US" },
				image: { alt: "Hasban Fardani, Full-Stack Engineer", type: "image/png" },
			}}
			twitter={{ card: "summary_large_image", title: s.seoTitle, description: s.seoDesc, image: `${siteUrl}/og.png`, imageAlt: "Hasban Fardani, Full-Stack Engineer" }}
			extend={{
				link: [
					{ rel: "alternate", hreflang: "en", href: `${siteUrl}/` },
					{ rel: "alternate", hreflang: "id", href: `${siteUrl}/id/` },
					{ rel: "alternate", hreflang: "x-default", href: `${siteUrl}/` },
					{ rel: "icon", type: "image/png", href: "/og.png" },
				],
				meta: [
					{ name: "robots", content: "index, follow, max-image-preview:large" },
					{ name: "author", content: "Hasban Fardani" },
					{ name: "theme-color", content: "#c2410c" },
				],
			}}
		/>
		<Font cssVariable="--font-heading" preload />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<script is:inline>
			(function () {
				try {
					var t = localStorage.getItem("hasban-theme");
					if (t !== "dark" && t !== "light") {
						t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
					}
					document.documentElement.setAttribute("data-theme", t);
				} catch (e) {
					document.documentElement.setAttribute("data-theme", "light");
				}
			})();
		</script>
	</head>
	<body>
		<div class="theme-wipe" id="themeWipe" aria-hidden="true"></div>

		<header class="pill-nav" id="pillNav">
			<a class="brand" href="#section-overview" aria-label="Hasban Fardani, home">
				<span class="brand-dot" aria-hidden="true"></span>
				<span class="brand-name">Hasban Fardani</span>
				<span class="brand-role">· Fullstack Engineer</span>
				<span class="brand-loc t-small" id="brandLoc">Cimahi / Bandung</span>
			</a>
			<nav class="nav-links" id="navLinks" aria-label="Homepage sections">
				<span class="nav-pill" id="navPill" aria-hidden="true"></span>
				{navList.map((item: any, i: number) => (
					<a class:list={["nav-link", i === 0 && "is-active"]} data-nav href={item.url}><span class="nav-label">{item.label}</span></a>
				))}
			</nav>
			<div class="nav-actions">
				<a class="lang-switch" href={isId ? "/" : "/id/"} hreflang={isId ? "en" : "id"} aria-label={isId ? "View in English" : "Lihat dalam Bahasa Indonesia"}>{isId ? "EN" : "ID"}</a>
				<button class="ask-btn" type="button" data-ask-open aria-haspopup="dialog">
					{s.askAi} <span class="kbd" aria-hidden="true">⌘K</span>
				</button>
				<button class="theme-toggle" id="themeToggle" type="button" aria-label="Toggle color theme">
					<svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
					<svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
					<span id="themeLabel">Dark</span>
				</button>
				<button class="burger" id="burger" type="button" aria-expanded="false" aria-controls="mobileMenu" aria-label="Open menu">
					<span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
				</button>
			</div>
			<nav class="mobile-menu" id="mobileMenu" aria-label="Homepage sections" hidden>
				{navList.map((item: any, i: number) => (
					<a class:list={["m-link", i === 0 && "is-active"]} data-nav-panel href={item.url}>{item.label}</a>
				))}
			</nav>
		</header>

		<main>
			<!-- 1) HERO -->
			<section class="hero container" id="section-overview" aria-label="Overview">
				<h1 class="t-display hero-title">
					<span class="mask"><span class="mask-line">{home.hero_line1} {home.hero_line2} {home.hero_line_accent}</span></span>
				</h1>
				<div class="hero-copy" id="heroCopy">
					<p class="t-body hero-pitch" data-hero-fade>{home.hero_pitch}</p>
					<div class="hero-ctas" data-hero-fade>
						<a class="btn btn-ink" href="#section-systems">{s.systems}</a>
						<a class="btn btn-ghost" href="#section-clients">{s.clients}</a>
						<button class="btn btn-accent" type="button" data-ask-open>Ask AI <span class="kbd" aria-hidden="true">⌘K</span></button>
					</div>
					<dl class="metrics" data-hero-fade>
						{metrics.map((m: any) => (
							<div class="metric"><dt class="t-small">{m.label}</dt><dd class="metric-value">{m.value}</dd></div>
						))}
					</dl>
				</div>

				{proofProject && (
					<figure class="proof" id="proofCard">
						{proofProject.data.featured_image && (
							<div class="proof-media"><Image image={proofProject.data.featured_image} loading="eager" /></div>
						)}
						<figcaption class="proof-cap">
							<p class="t-small proof-client">{[proofProject.data.client, proofProject.data.highlight].filter(Boolean).join(" · ")}</p>
							<p class="proof-title">{proofProject.data.title}</p>
							<a class="proof-link" href="#section-clients">{s.proofCta} <svg class="ext" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" /></svg></a>
						</figcaption>
					</figure>
				)}
				<div class="stack-index" id="stackIndex" aria-label="Technology stack">
					<p class="t-small stack-head">{s.stackHead}</p>
					<div class="rows" id="layerRows">
						{
							layers.map((l: any, i: number) => (
								<button
									class:list={["stack-row", i === 0 && "is-selected"]}
									type="button"
									data-layer={i}
									aria-pressed={i === 0 ? "true" : "false"}
								>
									<span class="row-main">
										<span class="row-title">{l.title}</span>
										<span class="row-tools">{l.badge}</span>
									</span>
									<span class="row-note">{l.description}</span>
								</button>
							))
						}
					</div>
					<p class="inspector-text" id="inspectorText" role="status">{layers[0]?.note}</p>
				</div>
			</section>

			<!-- 2) SYSTEMS -->
			<section class="section container" id="section-systems" aria-label="Enterprise and backend systems">
				<div class="manifesto" data-reveal="manifesto">
					<h2 class="t-h2 manifesto-head">{cleanKicker(home.manifesto_kicker)}</h2>
					<p class="manifesto-text" id="manifestoText">{home.manifesto}</p>
				</div>

				<header class="sec-head" data-reveal="head">
					<h2 class="t-h2">{cleanKicker(home.systems_kicker)}</h2>
					<p class="t-body sec-lead">{systemsTitle}</p>
					{home.systems_intro && <p class="t-body">{home.systems_intro}</p>}
				</header>

				<div class="deck">
					<aside class="monitor card" id="monitor" aria-label="Active case monitor" data-metric={firstCase?.data.metric} data-metric-label={firstCase?.data.metric_label} data-title={firstCase?.data.title}>
						<p class="t-small monitor-pos" id="monCounter">{cases.length ? `${caseWord} 1 ${ofWord} ${cases.length}` : ""}</p>
						<p class="mon-metric" id="monMetric">{firstCase?.data.metric}</p>
						<p class="t-small mon-label" id="monLabel">{firstCase?.data.metric_label}</p>
						<p class="mon-title" id="monTitle">{firstCase?.data.title}</p>
						<ol class="pipeline" id="monPipeline">
							{firstNodes.map((n: string) => <li>{n}</li>)}
						</ol>
						<div class="bars" id="monBars" aria-hidden="true">
							<span style="--w:100%"></span><span style="--w:96%"></span><span style="--w:92%"></span><span style="--w:70%"></span>
						</div>
					</aside>

					<div class="case-list">
						{
							cases.map((entry: any, i: number) => (
								<article class:list={["card", "case-card", i === 0 && "is-active"]} data-case={i} data-reveal="card" data-metric={entry.data.metric} data-metric-label={entry.data.metric_label} data-title={entry.data.title} data-pipeline={entry.data.pipeline}>
									<h3 class="t-h2 case-title">{entry.data.title}</h3>
									<p class="t-body">{[cleanKicker(entry.data.kicker), entry.data.summary].filter(Boolean).join(". ")}</p>
									<button class="btn btn-ghost inspect-btn" type="button" data-inspect={i} aria-expanded="false">
										{s.inspect}
									</button>
									<div class="code-wrap" data-code={i} hidden>
										<pre tabindex="0"><code>{entry.data.code}</code></pre>
									</div>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<!-- 3) CLIENTS -->
			<section class="section container" id="section-clients" aria-label="Live client platforms and SEO">
				<header class="sec-head card head-card" data-reveal="head">
					<h2 class="t-h2">{cleanKicker(home.clients_kicker)}</h2>
					<p class="t-body sec-lead">{home.clients_title}</p>
					<div class="serp-switch" role="group" aria-label="Choose a search result example">
						{serpItems.map((s: any, i: number) => (
							<button class:list={["btn", "serp-btn", i === 0 ? "btn-ink is-active" : "btn-ghost"]} type="button" data-serp={s.key} aria-pressed={i === 0 ? "true" : "false"}>{s.button_label}</button>
						))}
					</div>
				</header>

				<div class="serp card" data-reveal="scale" aria-label="Search result preview">
					<p class="t-small serp-query">{s.google} <span id="serpQuery">{firstSerp?.query}</span></p>
					<div class="serp-result">
						<p class="serp-rank">{s.organic}</p>
						<p class="t-small serp-url" id="serpUrl">{firstSerp?.url}</p>
						<p class="serp-title" id="serpTitle">{firstSerp?.title}</p>
						<p class="t-body serp-desc" id="serpDesc">{firstSerp?.description}</p>
						<p class="t-small serp-note" id="serpNote">{firstSerp?.note}</p>
						<a class="btn btn-ink serp-visit" id="serpVisit" href={firstSerp?.url} target="_blank" rel="noreferrer">{s.visit} <svg class="ext" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg></a>
					</div>
				</div>
				<script is:inline type="application/json" id="serpData" set:html={serpJson} />
				<script is:inline type="application/json" id="deckData" set:html={deckJson} />
				<script is:inline type="application/json" id="layerData" set:html={layerJson} />

				<div class="film" id="filmSection">
					<div class="film-head" data-reveal="head">
						<h3 class="t-h2 film-head-title">{s.builds}</h3>
						<div class="film-nav">
							<button class="btn btn-ghost" type="button" id="filmPrev"><svg class="ext" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg> {s.prev}</button>
							<button class="btn btn-ghost" type="button" id="filmNext">{s.next} <svg class="ext" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg></button>
						</div>
					</div>
					<div class="film-viewport" id="filmViewport">
						<div class="film-track" id="filmTrack">
							{
								projects.map((entry: any) => (
									<article class="card film-card" data-reveal="card">
										<div class="film-media">
											{entry.data.featured_image && <Image image={entry.data.featured_image} loading="lazy" />}
										</div>
										<div class="film-body">
											<p class="t-small film-client">{entry.data.client}{entry.data.highlight ? ` · ${entry.data.highlight}` : ""}</p>
											<h3 class="t-h2 film-title">{entry.data.title}</h3>
											<p class="t-body film-summary">{entry.data.summary}</p>
											<footer class="film-foot">
												<span class="t-small film-status">{entry.data.status_label}</span>
												{entry.data.url ? (
													<a href={entry.data.url} target="_blank" rel="noreferrer">{s.visit} <svg class="ext" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg></a>
												) : (
													<a href={`/work/${entry.id}`}>{s.viewProject}</a>
												)}
											</footer>
										</div>
									</article>
								))
							}
						</div>
					</div>
				</div>
			</section>

			<!-- 4) CAPABILITIES -->
			<section class="section container" id="section-capabilities" aria-label="Capabilities">
				<header class="sec-head" data-reveal="head">
					<h2 class="t-h2">{cleanKicker(home.capabilities_kicker)}</h2>
					<p class="t-body sec-lead">{home.capabilities_title}</p>
				</header>
				<div class="pillars">
					{
						pillars.map((entry: any) => (
							<article class="card pillar" data-tilt data-reveal="tilt">
								<h3 class="t-h2 pillar-title">{entry.data.title}</h3>
								<p class="t-body">{[cleanKicker(entry.data.kicker), entry.data.body].filter(Boolean).join(". ")}</p>
								{entry.data.badge && <p class="t-small pillar-badge">{entry.data.badge}</p>}
							</article>
						))
					}
				</div>
			</section>

			<!-- 5) EXPERIENCE -->
			<section class="section container" id="section-experience" aria-label="Experience">
				<header class="sec-head" data-reveal="head">
					<h2 class="t-h2">{cleanKicker(home.experience_kicker)}</h2>
					<p class="t-body sec-lead">{home.experience_title}</p>
				</header>
				<div class="timeline" id="timeline">
					<span class="laser" id="laser" aria-hidden="true"></span>
					{
						experiences.map((entry: any) => (
							<article class="card tl-item" data-reveal="card">
								<h3 class="t-h2 tl-org">{entry.data.title}</h3>
								<p class="t-small tl-meta">{entry.data.meta}</p>
								<div class:list={["tl-points", (entry.data.points?.length ?? 0) >= 3 ? "cols-3" : (entry.data.points?.length ?? 0) === 2 ? "cols-2" : "cols-1"]}>
									{(entry.data.points ?? []).map((pt: any) => (
										<div class="tl-point"><p class="tl-point-title">{pt.title}</p><p class="t-body">{pt.body}</p></div>
									))}
								</div>
							</article>
						))
					}
				</div>
			</section>

			{(certEntries.length > 0 || achEntries.length > 0) && (
				<section class="section container" aria-label="Recognition" data-reveal="head">
					<h2 class="t-h2">{s.recognition}</h2>
					<p class="t-body sec-lead">{s.recogLead}</p>
					<div class="recog">
						{certEntries.length > 0 && (
							<div>
								<h3 class="recog-head">{s.certificates}</h3>
								<ul class="recog-list">
									{certEntries.map((e: any) => (
										<li class="recog-item">
											<p class="recog-title">{e.data.title}</p>
											<p class="t-small recog-meta">{[e.data.issuer, e.data.year].filter(Boolean).join(" · ")}</p>
											{e.data.body && <p class="t-body">{e.data.body}</p>}
										</li>
									))}
								</ul>
							</div>
						)}
						{achEntries.length > 0 && (
							<div>
								<h3 class="recog-head">{s.achievements}</h3>
								<ul class="recog-list">
									{achEntries.map((e: any) => (
										<li class="recog-item">
											<p class="recog-title">{e.data.title}</p>
											<p class="t-small recog-meta">{[e.data.issuer, e.data.year].filter(Boolean).join(" · ")}</p>
											{e.data.body && <p class="t-body">{e.data.body}</p>}
										</li>
									))}
								</ul>
							</div>
						)}
					</div>
				</section>
			)}

			<!-- 6) CONTACT -->
			<section class="section container" id="section-contact" aria-label="Contact">
				<div class="card contact-card" data-reveal="scale">
					<h2 class="t-display contact-title">{home.contact_title}</h2>
					<p class="t-body contact-lead">{cleanKicker(home.contact_kicker)}</p>
					<p class="t-body">{home.contact_body}</p>
					<div class="contact-actions">
						<button class="btn btn-ink" type="button" id="copyEmail" data-email={home.contact_email}>{s.copyEmail} {home.contact_email}</button>
						<a class="btn btn-ghost" href={home.contact_whatsapp_url} target="_blank" rel="noreferrer">WhatsApp <svg class="ext" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg></a>
						<a class="btn btn-ghost" href={home.contact_website_url} target="_blank" rel="noreferrer">hasban.my.id <svg class="ext" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg></a>
						<button class="btn btn-accent" type="button" data-ask-open>Launch AI CV Assistant <span class="kbd" aria-hidden="true">⌘K</span></button>
					</div>
					<p class="t-small contact-foot">{home.contact_email} · Cimahi / Bandung</p>
				</div>
			</section>
		</main>

		<footer class="site-foot">
			<div class="container">
				<p class="t-display foot-name">Hasban Fardani</p>
				<p class="t-small foot-line">© Hasban Fardani, {s.footRole} · <a href="/work">{s.work}</a> · <a href="/about">{s.about}</a> · <a href="/contact">{s.contact}</a> · <a href="/_emdash/admin">Admin</a></p>
			</div>
		</footer>

		<!-- 7) AI DRAWER -->
		<div class="drawer-backdrop" id="drawerBackdrop" hidden></div>
		<aside class="drawer" id="aiDrawer" role="dialog" aria-modal="true" aria-labelledby="drawerTitle" aria-hidden="true" hidden>
			<header class="drawer-head">
				<div>
					<h2 class="t-h2" id="drawerTitle">{s.askTitle}</h2>
				</div>
				<button class="btn btn-ghost drawer-close" type="button" id="drawerClose" aria-label="Close AI assistant">{s.close}</button>
			</header>
			<div class="drawer-body">
				<div class="card welcome-card">
					<p class="t-body">{s.welcome}</p>
				</div>
				<div class="chips" role="group" aria-label="Suggested questions">
					<button class="chip" type="button" data-chip>{s.chip1}</button>
					<button class="chip" type="button" data-chip>{s.chip2}</button>
					<button class="chip" type="button" data-chip>{s.chip3}</button>
				</div>
				<div class="chat-log" id="chatLog" aria-live="polite"></div>
				<!-- chat log anchor -->
				<form class="chat-form" id="chatForm">
					<label class="sr-only" for="chatInput">Your question about Hasban</label>
					<input id="chatInput" name="question" type="text" maxlength="1000" placeholder={s.placeholder} autocomplete="off" />
					<button class="btn btn-accent" type="submit" id="chatSend">{s.send}</button>
				</form>
			</div>
		</aside>

		<style>
			* { box-sizing: border-box; }
			html { scroll-behavior: smooth; }
			body {
				margin: 0; background: var(--bg); color: var(--body);
				font-family: var(--font-heading), system-ui, sans-serif;
				font-size: var(--fs-body); line-height: 1.72;
				-webkit-font-smoothing: antialiased; overflow-x: hidden;
			}
			.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
			.container { max-width: var(--container); margin-inline: auto; padding-inline: var(--side-pad); }
			/* Sections separated by space (no hairlines); flat cards (no borders/shadows). */
			.section { padding-block: var(--section-gap); }
			.card {
				background: var(--card);
				border-radius: var(--card-radius); padding: var(--card-pad);
			}
			.ext { width: 0.85em; height: 0.85em; flex: none; vertical-align: -0.08em; }
			.sec-lead { margin: 0.7rem 0 0; }
			.manifesto-head { margin: 0 0 0.9rem; }
			.contact-lead { margin: 0 0 1rem; font-weight: 600; color: var(--ink); }
			.tl-meta { color: var(--muted); margin: 0 0 0.9rem; }
			.film-head-title { margin: 0; font-size: 1.15rem; }
			.serp-rank { font-weight: 700; color: var(--emerald); margin: 0 0 0.5rem; }
			.btn {
				display: inline-flex; align-items: center; gap: 0.5rem; cursor: pointer;
				padding: 0.72rem 1.25rem; border-radius: 999px; border: 0;
				font: inherit; font-size: 0.95rem; font-weight: 600; text-decoration: none;
				background: var(--ink); color: var(--bg); transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease;
			}
			.btn:hover { transform: translateY(-1px); }
			.btn-ink { background: var(--ink); color: var(--bg); }
			.btn-accent { background: var(--accent); color: #fff; }
			.btn-ghost {
				background: transparent; color: var(--ink); padding-inline: 0.4rem;
				text-decoration: underline; text-decoration-color: var(--surface-2);
				text-decoration-thickness: 2px; text-underline-offset: 5px;
			}
			.btn-ghost:hover { text-decoration-color: var(--accent); transform: none; }
			.btn-ghost.is-active { text-decoration-color: var(--accent); }
			.kbd {
				font-size: 0.72rem; padding: 0.1rem 0.38rem;
				border: 1px solid currentColor; border-radius: 6px; opacity: 0.75; /* taste-skill-ignore: key-cap outline denotes a physical key */
			}
			/* Theme wipe */
			.theme-wipe {
				position: fixed; inset: 0; z-index: 200; pointer-events: none;
				background: var(--bg); visibility: hidden;
			}
			/* Plain top bar: wordmark, links, one action. Flat, offset from edges. */
			.pill-nav {
				position: fixed; top: 10px; left: 0; right: 0; z-index: 100;
				display: flex; align-items: center;
				justify-content: space-between; gap: 1rem;
				width: min(var(--container), calc(100% - 20px)); margin-inline: auto;
				padding: 0.65rem 1rem;
				background: var(--surface); border-radius: 16px;
			}
			@media (max-width: 560px) {
				.pill-nav { gap: 0.45rem; padding: 0.6rem 0.8rem; }
			}
			.pill-nav.scrolled .brand-loc { display: none; }
			.brand { display: flex; align-items: center; gap: 0.55rem; text-decoration: none; color: var(--ink); font-weight: 800; white-space: nowrap; }
			.brand-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--accent); flex: none; }
			.brand-role { font-weight: 500; color: var(--muted); display: none; }
			.brand-loc { color: var(--muted); display: none; }
			@media (min-width: 1280px) { .brand-role { display: inline; } }
			@media (min-width: 1100px) { .brand-loc { display: inline-block; white-space: nowrap; } }
			.nav-links { display: flex; align-items: center; gap: 1.1rem; min-width: 0; overflow-x: auto; scrollbar-width: none; }
			.nav-links::-webkit-scrollbar { display: none; }
			.nav-pill {
				position: absolute; left: 0; right: 0; bottom: -3px; height: 2px;
				background: var(--accent); pointer-events: none;
			}
			.nav-link {
				position: relative; padding-block: 0.3rem;
				text-decoration: none; color: var(--body); font-size: 0.92rem; font-weight: 600; white-space: nowrap;
				transition: color 0.25s ease; flex: none;
			}
			.nav-link.is-active { color: var(--ink); }
			.nav-link:hover { color: var(--ink); }
			@media (max-width: 1280px) { .nav-links { gap: 0.85rem; } .nav-link { font-size: 0.87rem; } }
			.nav-actions { display: flex; align-items: center; gap: 0.5rem; flex: none; }
			.lang-switch {
				display: inline-flex; align-items: center; min-height: 44px;
				font-size: 0.85rem; font-weight: 700; color: var(--muted); text-decoration: none;
				padding: 0.4rem 0.55rem; border-radius: 999px;
			}
			.lang-switch:hover { color: var(--ink); }
			@media (max-width: 380px) {
				.brand-name { display: none; }
			}
			.ask-btn {
				display: inline-flex; align-items: center; gap: 0.45rem; cursor: pointer;
				background: var(--accent); color: #fff; border: 0; border-radius: 999px;
				padding: 0.55rem 1rem; min-height: 44px; font: inherit; font-size: 0.9rem; font-weight: 700;
			}
			.theme-toggle {
				display: inline-flex; align-items: center; justify-content: center; gap: 0.45rem; cursor: pointer;
				background: var(--card); color: var(--ink); border: 0;
				border-radius: 999px; padding: 0.55rem 0.85rem; min-height: 44px; min-width: 44px; font: inherit; font-size: 0.85rem; font-weight: 600;
			}
			[data-theme="light"] .icon-moon { display: none; }
			[data-theme="dark"] .icon-sun { display: none; }
			/* Hamburger + mobile menu (<=900px) */
			.burger {
				display: none; flex-direction: column; align-items: center; justify-content: center;
				gap: 4px; cursor: pointer; flex: none;
				background: var(--card); color: var(--ink); border: 0;
				border-radius: 999px; width: 44px; height: 44px; padding: 0;
			}
			.burger span { display: block; width: 16px; height: 2px; border-radius: 2px; background: currentColor; transition: transform 0.25s ease, opacity 0.2s ease; }
			.burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
			.burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
			.burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }
			.mobile-menu {
				position: absolute; top: calc(100% + 10px); left: 0; right: 0;
				background: var(--card); border-radius: var(--card-radius);
				padding: 0.55rem; display: grid; gap: 0.15rem;
				box-shadow: 0 24px 48px -20px rgba(0, 0, 0, 0.28); /* taste-skill-ignore: real floating menu, shadow allowed */
				transform-origin: top center; animation: menu-in 0.28s cubic-bezier(0.22, 1, 0.36, 1);
			}
			.mobile-menu[hidden] { display: none; }
			@keyframes menu-in { from { opacity: 0; transform: translateY(-8px) scale(0.98); } to { opacity: 1; transform: none; } }
			.m-link {
				display: block; padding: 0.8rem 1rem; border-radius: var(--card-radius);
				color: var(--body); font-weight: 600; font-size: 0.95rem; text-decoration: none;
			}
			.m-link:hover { background: var(--surface); color: var(--ink); }
			.m-link.is-active { background: var(--surface); color: var(--ink); }
			@media (max-width: 1150px) {
				.nav-links { display: none; }
				.burger { display: inline-flex; }
			}
			@media (max-width: 900px) {
				.stack-card { position: static; }
			}
			@media (min-width: 1151px) { .mobile-menu { display: none; } }
			@media (max-width: 560px) {
				.pill-nav { gap: 0.5rem; padding: 0 0.5rem 0 0.9rem; }
				#themeLabel { display: none; }
				.theme-toggle { padding: 0.55rem 0.65rem; }
				.ask-btn { padding: 0.5rem 0.8rem; font-size: 0.85rem; }
				.hero-ctas { display: grid; grid-template-columns: 1fr 1fr; }
				.hero-ctas .btn { justify-content: center; }
				.hero-ctas .btn-accent { grid-column: 1 / -1; }
				.metric dd { font-size: 1.35rem; }
			}
			@media (pointer: coarse) { .ask-btn .kbd { display: none; } }
			/* Hero: full-width statement, then copy + stack. One face, one colour. */
			.hero {
				padding-top: 8.5rem; padding-bottom: var(--section-gap);
				display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(2rem, 4vw, 4rem); align-items: start;
			}
			.hero-title { grid-column: 1 / -1; margin: 0; max-width: 22ch; }
			@media (max-width: 900px) { .hero { grid-template-columns: 1fr; } }
			.mask { display: block; overflow: hidden; padding-bottom: 0.08em; }
			.mask-line { display: block; will-change: transform; }
			.hero-pitch { margin: 0 0 1.8rem; }
			.hero-pitch strong { color: var(--ink); }
			.hero-ctas { display: flex; flex-wrap: wrap; gap: 0.65rem; margin-bottom: 2.4rem; }
			.metrics { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin: 0; }
			@media (max-width: 640px) { .metrics { grid-template-columns: repeat(2, 1fr); } }
			.metric dt { color: var(--muted); margin-bottom: 0.35rem; }
			.metric dd { margin: 0; font-size: 1.65rem; font-weight: 800; color: var(--ink); letter-spacing: -0.02em; }
			.metric dd span { font-size: 1rem; font-weight: 700; color: var(--muted); }
			.proof { margin: 0; }
			.proof-media { aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--card-radius); background: var(--surface); }
			.proof-media :global(img) { width: 100%; height: 112%; object-fit: cover; display: block; will-change: transform; }
			.proof-cap { padding-top: 0.9rem; display: grid; gap: 0.25rem; }
			.proof-client { color: var(--muted); margin: 0; }
			.proof-title { font-size: 1.35rem; font-weight: 800; letter-spacing: -0.02em; color: var(--ink); margin: 0; }
			.proof-link { color: var(--accent); font-weight: 700; text-decoration: none; width: fit-content; }
			.proof-link:hover { text-decoration: underline; text-underline-offset: 4px; }
			.stack-index { grid-column: 1 / -1; margin-top: 0.5rem; }
			.stack-head { color: var(--muted); margin: 0 0 0.8rem; }
			.rows { display: grid; }
			.stack-row {
				text-align: left; cursor: pointer; width: 100%; font: inherit;
				border: 0; border-top: 2px solid var(--surface-2); background: transparent;
				padding: 1rem 0.25rem; display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;
				color: var(--body); transition: background 0.2s ease, padding 0.25s ease;
			}
			.stack-row:last-of-type { border-bottom: 2px solid var(--surface-2); }
			.stack-row:hover { background: var(--surface); }
			.stack-row.is-selected { background: var(--surface); }
			.stack-row.is-selected .row-title { color: var(--accent); }
			.row-main { display: grid; gap: 0.2rem; align-content: start; }
			.row-title { font-weight: 800; color: var(--ink); font-size: 1.05rem; }
			.row-tools { font-size: 0.88rem; color: var(--muted); }
			.row-note { font-size: 0.95rem; color: var(--body); line-height: 1.6; }
			@media (max-width: 760px) { .stack-row { grid-template-columns: 1fr; gap: 0.4rem; } }
			.inspector-text { margin: 1.1rem 0 0; font-size: 1.05rem; font-weight: 600; color: var(--ink); max-width: 70ch; min-height: 2.6em; }
			/* Sections */
			.sec-head { margin-bottom: 2.2rem; max-width: 820px; }
			.head-card { max-width: none; }
			.manifesto { max-width: 900px; margin-bottom: 3.5rem; }
			.manifesto-text { font-size: clamp(1.3rem, 2.1vw, 1.9rem); line-height: 1.45; font-weight: 600; color: var(--ink); margin: 0; }
			.manifesto-text .w { opacity: 0.16; }
			.deck { display: grid; grid-template-columns: 380px 1fr; gap: 1.4rem; align-items: start; }
			@media (max-width: 900px) { .deck { grid-template-columns: 1fr; } .monitor { position: static; } }
			.monitor { position: sticky; top: 96px; overflow: hidden; }
			.monitor-pos { color: var(--muted); margin: 0 0 0.6rem; }
			.mon-metric { font-size: 2.2rem; font-weight: 800; color: var(--ink); margin: 0 0 0.2rem; letter-spacing: -0.02em; }
			.mon-label { color: var(--muted); margin: 0 0 0.8rem; }
			.mon-title { font-weight: 700; color: var(--ink); margin: 0 0 1.1rem; }
			.pipeline { list-style: none; margin: 0 0 1.2rem; padding: 0; display: grid; gap: 0.45rem; }
			.pipeline li {
				padding: 0.55rem 0.8rem; border-radius: var(--card-radius);
				background: var(--surface); color: var(--ink); font-size: 0.9rem; font-weight: 600;
			}
			.bars { display: grid; gap: 0.45rem; }
			.bars span { display: block; height: 6px; border-radius: 99px; background: var(--surface); position: relative; overflow: hidden; }
			.bars span::after { content: ""; position: absolute; inset: 0 auto 0 0; width: var(--w); background: var(--accent); border-radius: 99px; transition: width 0.7s cubic-bezier(0.22, 1, 0.36, 1); }
			.case-list { display: grid; gap: 1.4rem; }
			.case-card { background: var(--surface); }
			.case-card.is-active { background: var(--card); }
			.case-title { margin-bottom: 0.7rem; }
			.inspect-btn { margin-top: 1.1rem; }
			.code-wrap { margin-top: 1.1rem; border: 1px solid var(--line); border-radius: var(--card-radius); overflow: hidden; background: #141416; /* taste-skill-ignore: real code block, lines allowed */ }
			.code-lang { color: var(--muted); padding: 0.7rem 1rem 0; margin: 0; }
			.code-wrap pre { margin: 0; padding: 1rem; overflow-x: auto; }
			.code-wrap code { font-family: var(--font-code); font-size: 0.82rem; line-height: 1.65; color: #f2f0e8; white-space: pre; }
			/* SERP + film */
			.serp-switch { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.4rem; }
			.serp { margin-bottom: 2.2rem; }
			.serp-query { color: var(--muted); margin: 0 0 1.1rem; }
