					const words = man.textContent.trim().split(/\s+/);
					man.textContent = "";
					words.forEach((w) => {
						const s = document.createElement("span");
						s.className = "w"; s.textContent = w;
						man.appendChild(s); man.appendChild(document.createTextNode(" "));
					});
					gsap.set("#manifestoText .w", { opacity: 0.12, y: 8, color: "var(--muted)" });
					gsap.to("#manifestoText .w", {
						opacity: 1, y: 0, color: "var(--ink)", stagger: 0.05, ease: "none",
						scrollTrigger: {
							trigger: man.closest(".manifesto") || man,
							start: "top 78%", end: () => `+=${Math.max(400, words.length * 22)}`,
							scrub: 0.6,
						},
					});
				}

				/* Metrics count-up for real numbers (10+) */
				$$(".metric-value").forEach((el) => {
					const m = el.textContent.match(/([\d.,]+)/);
					if (!m) return;
					const target = Number(m[1].replace(/[.,]/g, ""));
					if (!target || target < 10) return;
					const prefix = el.textContent.slice(0, m.index);
					const suffix = el.textContent.slice(m.index + m[1].length);
					const useDot = m[1].includes(".");
					const obj = { v: 0 };
					ScrollTrigger.create({
						trigger: el, start: "top 92%", once: true,
						onEnter: () => gsap.to(obj, {
							v: target, duration: 1.5, ease: "power2.out",
							onUpdate: () => {
								const n = Math.round(obj.v).toLocaleString("en-US");
								el.textContent = prefix + (useDot ? n.replace(/,/g, ".") : n) + suffix;
							},
						}),
					});
				});

				/* Pillar drift: scrubbed opposing parallax across the grid */
				$$("[data-tilt]").forEach((card, i) => {
					const dir = i % 2 === 0 ? -36 : 36;
					gsap.fromTo(card, { x: dir }, {
						x: 0, ease: "none",
						scrollTrigger: { trigger: "#section-capabilities", start: "top bottom", end: "center center", scrub: true },
					});
				});

				/* Magnetic primary actions (pointer-fine only) */
				if (window.matchMedia("(pointer: fine)").matches) {
					$$(".btn-ink, .btn-accent, .ask-btn").forEach((btn) => {
						const xTo = gsap.quickTo(btn, "x", { duration: 0.3, ease: "power3.out" });
						const yTo = gsap.quickTo(btn, "y", { duration: 0.3, ease: "power3.out" });
						btn.addEventListener("mousemove", (e) => {
							const r = btn.getBoundingClientRect();
							xTo((e.clientX - r.left - r.width / 2) * 0.22);
							yTo((e.clientY - r.top - r.height / 2) * 0.28);
						});
						btn.addEventListener("mouseleave", () => { xTo(0); yTo(0); });
					});
				}

				/* Deck sync: monitor follows active case */
				const CASES = (parseJson('deckData') || []).map(function(c, idx){ return Object.assign({}, c, { bars: [100,94,88,76].map(function(v,j){ return String(Math.max(55, v - idx*4 - j*2)) + '%'; }) }); });
				const monEls = {
					counter: $("#monCounter"), metric: $("#monMetric"),
					label: $("#monLabel"), title: $("#monTitle"), pipeline: $("#monPipeline"),
					bars: $$("#monBars span"),
				};
				function setCase(i) {
					const c = CASES[i];
					if (!c) return;
					$$(".case-card").forEach((el) => el.classList.toggle("is-active", Number(el.dataset.case) === i));
					monEls.counter.textContent = c.counter;
					monEls.metric.textContent = c.metric;
					monEls.label.textContent = c.label;
					monEls.title.textContent = c.title;
					monEls.pipeline.textContent = "";
					c.nodes.forEach((n) => {
						const li = document.createElement("li");
						li.textContent = n;
						monEls.pipeline.appendChild(li);
					});
					monEls.bars.forEach((b, idx) => b.style.setProperty("--w", c.bars[idx] || "60%"));
					gsap.fromTo("#monitor", { y: 8 }, { y: 0, duration: 0.45, ease: "power2.out", overwrite: true });
				}
				$$(".case-card").forEach((card) => {
					const i = Number(card.dataset.case);
					ScrollTrigger.create({
						trigger: card, start: "top 58%", end: "bottom 58%",
						onEnter: () => setCase(i), onEnterBack: () => setCase(i),
					});
				});

				/* Pinned horizontal filmstrip >=1024px (centered pin) */
				const mm = gsap.matchMedia();
				mm.add("(min-width: 1024px)", () => {
					const track = $("#filmTrack");
					const viewport = $("#filmViewport");
					const getX = () => Math.max(0, track.scrollWidth - viewport.clientWidth);
					const tween = gsap.to(track, {
						x: () => -getX(), ease: "none",
						scrollTrigger: {
							trigger: "#filmSection", start: "center center", end: () => `+=${getX()}`,
							pin: true, scrub: 1, invalidateOnRefresh: true, anticipatePin: 1,
							id: "filmPin",
						},
					});
					gsap.utils.toArray(".film-media :is(img, picture img)").forEach((img) => {
						gsap.fromTo(img, { xPercent: -6 }, {
							xPercent: 6, ease: "none",
							scrollTrigger: { trigger: "#filmSection", start: "center center", end: () => `+=${getX()}`, scrub: true },
						});
					});
					$("#filmPrev")?.addEventListener("click", () => {
						window.scrollTo({ top: tween.scrollTrigger.start, behavior: "smooth" });
					});
					$("#filmNext")?.addEventListener("click", () => {
						window.scrollTo({ top: tween.scrollTrigger.end, behavior: "smooth" });
					});
					return () => { gsap.set(track, { x: 0 }); };
				});
				/* Mobile: Prev/Next fall back to native horizontal-less stack scroll */
				if (window.innerWidth < 1024) {
					$("#filmPrev")?.addEventListener("click", () => $("#filmSection")?.scrollIntoView({ behavior: "smooth" }));
					$("#filmNext")?.addEventListener("click", () => $("#section-capabilities")?.scrollIntoView({ behavior: "smooth" }));
				}

				/* Laser line scrub */
				gsap.to("#laser", {
					scaleY: 1, ease: "none",
					scrollTrigger: { trigger: "#timeline", start: "top 78%", end: "bottom 55%", scrub: true },
				});

				window.addEventListener("load", () => ScrollTrigger.refresh());
				document.addEventListener("astro:page-hide", () => {
					ScrollTrigger.getAll().forEach((t) => t.kill());
				});
			} else {
				/* Reduced motion / no GSAP: everything visible, film stays vertical */
				$$(".mask-line").forEach((el) => { el.style.transform = "none"; });
				const man = $("#manifestoText");
				if (man) man.style.opacity = "1";
			}
		</script>
	</body>
</html>
