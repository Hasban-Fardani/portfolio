{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portfolio",
	"account_id": "cd4a1d42e74f9b8d4c6ee9523e00179c",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"vars": {
		"OPENROUTER_MODEL": "openrouter/free"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "my-portfolio-site",
			"database_id": "d357c0cf-3717-4df7-84fa-ac7c7915e07c"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "my-portfolio-media"
		}
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"]
	}
}
